<?xml version="1.0"?>
<ruleset xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:noNamespaceSchemaLocation="vendor/squizlabs/php_codesniffer/phpcs.xsd">
    <config name="php_version" value="80000"/>

    <arg value="ps"/>
    <arg name="colors"/>
    <arg name="parallel" value="16"/>

    <file>Console</file>
    <file>config</file>
    <file>src</file>
    <file>tests</file>
    <!-- The input and the expected output of the Rector rules, written as applications write them -->
    <exclude-pattern>tests/fixtures/rector/*</exclude-pattern>

    <rule ref="CakePHP2"/>
</ruleset>
