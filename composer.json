{
    "name": "pieceofcake2/upgrade",
    "description": "Upgrade shell that converts CakePHP 1.3 applications to CakePHP 2",
    "type": "cakephp-plugin",
    "keywords": ["cakephp", "cakephp2", "upgrade"],
    "license": "MIT",
    "require": {
        "php": ">=8.0",
        "composer/installers": "^1.0 || ^2.0",
        "nikic/php-parser": "^5.0",
        "pieceofcake2/cakephp": "^2.12",
        "rector/rector": "^2.7"
    },
    "require-dev": {
        "phpstan/phpstan": "^2.1",
        "phpunit/phpunit": "^9.6",
        "pieceofcake2/app": "^2.2",
        "pieceofcake2/phpcs-cakephp2": "^1.1",
        "pieceofcake2/phpstan-cakephp2": "^1.0"
    },
    "autoload": {
        "psr-4": {
            "PieceOfCake2\\Upgrade\\": "src/"
        }
    },
    "config": {
        "sort-packages": true,
        "allow-plugins": {
            "composer/installers": true,
            "dealerdirect/phpcodesniffer-composer-installer": true
        }
    },
    "extra": {
        "installer-name": "Upgrade"
    }
}
