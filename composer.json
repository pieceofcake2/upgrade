{
    "name": "pieceofcake2/upgrade",
    "description": "Upgrade plugin for CakePHP 2.x - Legacy upgrade tool",
    "type": "cakephp-plugin",
    "keywords": ["cakephp", "cakephp2", "upgrade"],
    "license": "MIT",
    "require": {
        "php": ">=8.0",
        "composer/installers": \"^1.0 || ^2.0\",
        "pieceofcake2/cakephp": "^2.12"
    },
    "require-dev": {
        "cakephp/cakephp-codesniffer": "^5.0",
        "phpstan/phpstan": "^2.1",
        "phpunit/phpunit": "^9.6",
        "pieceofcake2/app": "^2.2",
        "pieceofcake2/phpstan-cakephp2": "^0.2.1"
    },
    "config": {
        "sort-packages": true,
        "allow-plugins": {
            "composer/installers": true,
            "dealerdirect/phpcodesniffer-composer-installer": true
        }
    },
    "extra": {
        "installer-name": "Upgrade"
    }
}
